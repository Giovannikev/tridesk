# Copier en .env puis remplacer chaque « change-me ».
# Génère des valeurs aléatoires avec :  openssl rand -hex 24
# Le fichier .env n'est jamais versionné (voir .gitignore).

TZ=Europe/Paris

# --- PostgreSQL + pgvector (tickets, base de connaissances) ---
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
# Rôle en lecture seule utilisé par Grafana
GRAFANA_DB_PASSWORD=change-me

# --- n8n ---
N8N_PORT=5679
# Clé qui chiffre les credentials dans n8n : à générer une fois, à ne plus changer
N8N_ENCRYPTION_KEY=change-me
# Clé à envoyer dans l'en-tête X-API-Key pour appeler l'API des tickets
TICKETS_API_KEY=change-me

# --- LLM (Ollama, dans la stack) ---
# qwen2.5:1.5b tient dans 4-5 Go de RAM Docker (≈ 15-60 s par étape sur un CPU portable).
# Avec plus de RAM (≥ 8 Go alloués à Docker) : qwen2.5:3b ou qwen2.5:7b, meilleure rédaction.
CHAT_MODEL=qwen2.5:1.5b
EMBED_MODEL=bge-m3
# Sous ce seuil de confiance (0-1), le ticket part chez un humain
CONFIDENCE_MIN=0.6
# Similarité cosinus minimale pour qu'un extrait de la base serve de source
SIMILARITY_MIN=0.5

# --- E-mail ---
# Boîte de test GreenMail qui reçoit les tickets (support@support.local)
GREENMAIL_PASSWORD=change-me
# Expéditeur des réponses et destinataire des escalades (captés par Mailpit)
SUPPORT_FROM_EMAIL=support@support.local
AGENT_EMAIL=agent@support.local
MAILPIT_PORT=8025

# --- Telegram (facultatif) ---
# Jeton donné par @BotFather. Vide = canal Telegram désactivé.
TELEGRAM_BOT_TOKEN=
# Chat ID de l'agent qui reçoit aussi les escalades sur Telegram (facultatif)
TELEGRAM_AGENT_CHAT_ID=

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

SWAGGER_PORT=8081
