    {
      "id": 8,
      "type": "timeseries",
      "title": "Délais de traitement (médianes)",
      "description": "Délai médian depuis la réception, par étape. Échelle logarithmique : de quelques secondes (LLM) à plusieurs heures (humain).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "p04-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "p04-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(received_at, $__interval),\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY classification_s) AS \"Classification\",\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY first_response_s) FILTER (WHERE answered_by = 'bot') AS \"1re réponse (bot)\",\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY escalation_s) AS \"Escalade\",\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY resolution_s) FILTER (WHERE resolved_by = 'humain') AS \"Résolution (humain)\"\nFROM v_ticket_durations WHERE $__timeFilter(received_at) AND channel IN (${canal:sqlstring}) AND (NOT is_demo OR '${demo}' = 'oui')\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": true,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Volume par catégorie",
      "description": "Tickets par catégorie, en distinguant réponse automatique et escalade.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "p04-pg"
      },
      "gridPos": {
