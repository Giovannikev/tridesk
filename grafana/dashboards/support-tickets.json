          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS tickets FROM tickets WHERE $__timeFilter(received_at) AND channel IN (${canal:sqlstring}) AND (NOT is_demo OR '${demo}' = 'oui')"
