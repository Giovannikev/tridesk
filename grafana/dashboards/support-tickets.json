            "uid": "p04-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(category, 'non classé') AS \"Catégorie\",\n       count(*) FILTER (WHERE NOT escalated) AS \"Réponse automatique\",\n       count(*) FILTER (WHERE escalated) AS \"Escaladé\"\nFROM tickets WHERE $__timeFilter(received_at) AND channel IN (${canal:sqlstring}) AND (NOT is_demo OR '${demo}' = 'oui')\nGROUP BY 1 ORDER BY count(*) DESC"
        }
      ],
