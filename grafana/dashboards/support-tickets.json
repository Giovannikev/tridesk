    {
      "id": 12,
      "type": "table",
      "title": "Délais et escalade par priorité",
      "description": "Synthèse par priorité (secondes converties automatiquement).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "p04-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
