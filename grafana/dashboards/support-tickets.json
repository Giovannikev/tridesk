            "uid": "p04-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(avg(CASE WHEN escalated THEN 1.0 ELSE 0 END), 0) AS taux FROM tickets WHERE $__timeFilter(received_at) AND channel IN (${canal:sqlstring}) AND (NOT is_demo OR '${demo}' = 'oui') AND status <> 'recu'"
