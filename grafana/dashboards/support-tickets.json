          "rawSql": "SELECT $__timeGroupAlias(received_at, $__interval), channel AS metric, count(*) AS value FROM tickets WHERE $__timeFilter(received_at) AND channel IN (${canal:sqlstring}) AND (NOT is_demo OR '${demo}' = 'oui') GROUP BY 1, 2 ORDER BY 1"
