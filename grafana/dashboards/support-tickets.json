            "uid": "p04-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT priority AS \"Priorité\", count(*) AS \"Tickets\",\n       avg(CASE WHEN escalated THEN 1.0 ELSE 0 END) AS \"Taux d'escalade\",\n       avg(classification_s) AS \"Classification (moy.)\",\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY first_response_s) AS \"1re réponse (médiane)\",\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY resolution_s) AS \"Résolution (médiane)\",\n       percentile_cont(0.9) WITHIN GROUP (ORDER BY resolution_s) AS \"Résolution (p90)\"\nFROM v_ticket_durations WHERE $__timeFilter(received_at) AND channel IN (${canal:sqlstring}) AND (NOT is_demo OR '${demo}' = 'oui') AND priority IS NOT NULL\nGROUP BY priority\nORDER BY array_position(ARRAY['critique','haute','normale','basse'], priority)"
        }
