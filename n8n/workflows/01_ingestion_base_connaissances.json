      "id": "08371f16-8d32-548e-aa50-a93b288b86f2",
      "name": "Texte",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1100,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "// Découpe chaque fiche par section « ## » ; les sections longues sont coupées par paragraphes.\nconst MAX = 1200;\nconst chunks = [];\nfor (const item of $input.all()) {\n  const fileName = item.binary?.data?.fileName || item.json.fileName || 'inconnu.md';\n  const text = (item.json.text || '').replace(/\\r/g, '');\n  const title = (text.match(/^#\\s+(.+)$/m) || [null, fileName])[1].trim();\n  const parts = text.split(/^##\\s+/m).slice(1);\n  let idx = 0;\n  for (const part of parts) {\n    const [head, ...rest] = part.split('\\n');\n    const section = head.trim();\n    const body = rest.join('\\n').trim();\n    const paras = body.split(/\\n\\s*\\n/);\n    let buf = '';\n    const flush = () => {\n      if (!buf.trim()) return;\n      chunks.push({ doc_path: fileName, doc_title: title, section, chunk_index: idx++,\n                    content: `${title} — ${section}\\n${buf.trim()}` });\n      buf = '';\n    };\n    for (const p of paras) {\n      if ((buf + '\\n\\n' + p).length > MAX) flush();\n      buf += (buf ? '\\n\\n' : '') + p;\n    }\n    flush();\n  }\n}\nif (!chunks.length) throw new Error('Aucune section « ## » trouvée dans /data/kb/*.md');\nreturn [{ json: { chunks, inputs: chunks.map(c => c.content) } }];"
      },
      "id": "59324ac3-454f-55f4-808c-22b1308b8e3e",
      "name": "Découpage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.EMBED_MODEL, input: $json.inputs }) }}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "48c6e097-ba49-5f7e-aa67-3c60890010d7",
      "name": "Ollama · embeddings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const { chunks } = $('Découpage').first().json;\nconst embeddings = $json.embeddings || [];\nif (embeddings.length !== chunks.length) throw new Error(`Embeddings reçus : ${embeddings.length} / ${chunks.length}`);\nconst rows = chunks.map((c, i) => ({ ...c, embedding: JSON.stringify(embeddings[i]), model: $json.model }));\nreturn [{ json: { rows: JSON.stringify(rows), count: rows.length } }];"
      },
      "id": "a4e6336e-c81a-5c04-82c5-de93657c7b16",
      "name": "Lignes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        40
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH purge AS (DELETE FROM kb_chunks RETURNING 1),\n     ins AS (\n       INSERT INTO kb_chunks (doc_path, doc_title, section, chunk_index, content, embedding, model)\n       SELECT r.doc_path, r.doc_title, r.section, r.chunk_index, r.content, r.embedding::vector, r.model\n       FROM jsonb_to_recordset($1::jsonb) AS r(doc_path text, doc_title text, section text,\n                                               chunk_index int, content text, embedding text, model text)\n       RETURNING doc_path)\nSELECT 'ok' AS status, count(*)::int AS chunks, count(DISTINCT doc_path)::int AS documents,\n       (SELECT count(*) FROM purge)::int AS anciens_chunks_supprimes\nFROM ins;",
        "options": {
          "queryReplacement": "={{ [ $json.rows ] }}"
        }
      },
      "id": "0f942337-32fc-5229-82c6-b7d3a880a718",
      "name": "Remplacer l'index",
