      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: 'Bonjour 👋 Je suis l\\'assistant du support Odoo. Décrivez votre problème en un message (application, action, message d\\'erreur) : je vous réponds à partir de notre base de connaissances, ou je transmets à un conseiller.' }) }}",
        "options": {
          "timeout": 20000
        }
      },
