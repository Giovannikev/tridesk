        "responseMode": "responseNode",
        "options": {}
      },
      "id": "e85d00f8-bff2-5dad-9d41-107552ab42f1",
      "name": "POST /tickets",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "p04CredApiKey001",
          "name": "P04 API Key"
        }
      },
      "webhookId": "55a2b210-7213-5f57-860b-25953b33d72d"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst errors = [];\nconst str = (v, max) => (v === undefined || v === null) ? null : String(v).trim().slice(0, max) || null;\nconst message = str(b.message, 10000);\nif (!message || message.length < 5) errors.push('message : obligatoire (5 caractères minimum)');\nconst customer = (b.customer && typeof b.customer === 'object') ? b.customer : {};\nconst email = str(customer.email, 200);\nif (email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) errors.push('customer.email : adresse invalide');\nreturn [{ json: {\n  valid: errors.length === 0, errors,\n  message, subject: str(b.subject, 200), customer_name: str(customer.name, 120), customer_email: email,\n  external_id: str(b.external_id, 200),\n} }];"
      },
      "id": "e92e8bb9-4cb8-5c62-ac15-83bad7921f29",
      "name": "Validation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
