    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tickets (channel, external_id, customer_name, customer_contact, subject, body)\nVALUES ('webhook', $1, $2, $3, $4, $5)\nON CONFLICT (channel, external_id) DO UPDATE SET updated_at = now()\nRETURNING id AS ticket_id, status, received_at, (xmax <> 0) AS duplicate;",
        "options": {
          "queryReplacement": "={{ [ $json.external_id, $json.customer_name, $json.customer_email, $json.subject, $json.message ] }}"
        }
      },
      "id": "edd81cb5-4d80-5d70-82ca-ee68ef6ea64c",
