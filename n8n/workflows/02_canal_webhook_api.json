    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id AS ticket_id, channel, status, subject, body AS message, customer_name, customer_contact,\n       category, priority, confidence::float AS confidence, wants_human, summary, suggested_answer, sources,\n       answerable, final_answer, answered_by, escalated, escalation_reasons, resolved_by, resolution_note,\n       received_at, classified_at, answered_at, escalated_at, resolved_at\nFROM tickets WHERE id = $1;",
        "options": {
          "queryReplacement": "={{ [ parseInt($json.query?.id, 10) || 0 ] }}"
        }
