    {
      "parameters": {
        "jsCode": "const t = $json;\nconst hello = t.customer_name ? `Bonjour ${t.customer_name},` : 'Bonjour,';\nreturn { json: {\n  ticket_id: Number(t.ticket_id), channel: t.channel, contact: t.customer_contact, subject: t.subject,\n  text: `${hello}\\n\\n${t.final_answer}\\n\\nVotre demande (ticket n°${t.ticket_id}) est maintenant clôturée.\\nL'équipe support`,\n} };",
