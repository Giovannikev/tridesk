    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tickets\nSET status = 'resolu', resolved_at = now(), resolved_by = 'humain', resolution_note = $3,\n    final_answer = COALESCE($2, final_answer),\n    answered_by  = CASE WHEN $2 IS NOT NULL THEN 'humain' ELSE answered_by END,\n    answered_at  = CASE WHEN $2 IS NOT NULL THEN COALESCE(answered_at, now()) ELSE answered_at END\nWHERE id = $1 AND status <> 'resolu'\nRETURNING id AS ticket_id, channel, customer_name, customer_contact, subject, status, resolved_at,\n          final_answer, ($2 IS NOT NULL) AS send_answer;",
        "options": {
          "queryReplacement": "={{ [ parseInt($json.body?.ticket_id, 10) || 0, ($json.body?.answer || '').trim() || null, [ $json.body?.agent, $json.body?.note ].filter(Boolean).join(' : ') || null ] }}"
        }
