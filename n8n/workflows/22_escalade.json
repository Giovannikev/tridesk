    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tickets\nSET status = 'escalade', escalated = true, escalated_at = now(),\n    escalation_reasons = ARRAY(SELECT jsonb_array_elements_text($2::jsonb))\nWHERE id = $1\nRETURNING id AS ticket_id;",
        "options": {
          "queryReplacement": "={{ [ $json.ticket_id, JSON.stringify($json.reasons) ] }}"
        }
      },
