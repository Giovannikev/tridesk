              "id": "7656333f-f91b-406f-8e5b-a64a6b6a6270",
              "leftValue": "={{ $json.escalate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "630ed515-02a0-5828-b3bb-d7c00012e6af",
      "name": "Escalader ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
